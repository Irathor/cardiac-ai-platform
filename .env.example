# Copy to .env and fill in real values. Never commit the real .env file.
ENVIRONMENT=development

# --- Postgres ---
POSTGRES_DB=cardiac_ai
POSTGRES_USER=cardiac_ai
POSTGRES_PASSWORD=change-me-strong-password

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ACCESS_KEY=cardiac_ai_admin
MINIO_SECRET_KEY=change-me-strong-secret
MINIO_BUCKET_IMAGES=cardiac-images
MINIO_SECURE=false

# --- Auth (JWT) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
